[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-r": "workspace::Reload",
      "cmd-shift-e": "workspace::ToggleLeftDock",
      "cmd-j": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-f": "editor::Format",
      "cmd-/": "editor::ToggleComments",
      "ctrl-c": "editor::Cancel"
    }
  }
]
