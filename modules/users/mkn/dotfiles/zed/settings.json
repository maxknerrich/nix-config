{
  "cli_default_open_behavior": "new_window",
  "base_keymap": "VSCode",
  "theme": {
    "mode": "dark",
    "light": "Vitesse Refined Dark",
    "dark": "Vitesse Refined Black"
  },
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "buffer_font_weight": 500,
  "format_on_save": "on",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "vim_mode": false,
  "hard_tabs": true,
  "cursor_blink": false,
  "soft_wrap": "editor_width",
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "collaboration_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right"
  },
  "project_panel": {
    "dock": "right",
    "button": true,
    "entry_spacing": "standard"
  },
  "lsp": {
    "vtsls": {
      "enable_lsp_tasks": true,
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      }
    },
    "nixd": {
      "binary": {
        "path": "nixd"
      }
    }
  },
  "languages": {
    "Nix": {
      "tab_size": 2,
      "language_servers": [
        "nixd"
      ],
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": [
            "-"
          ]
        }
      }
    },
    "JSON": {
      "tab_size": 2
    },
    "Markdown": {
      "soft_wrap": "editor_width"
    },
    "TSX": {
      "show_edit_predictions": true
    }
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "tabs": {
    "file_icons": false,
    "git_status": false
  },
  "tab_bar": {
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_user_picture": false,
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_sign_in": false
  },
  "status_bar": {
    "active_language_button": true
  },
  "icon_theme": {
    "mode": "dark",
    "light": "JetBrains New UI Icons (Dark)",
    "dark": "JetBrains Icons Dark"
  },
  "terminal": {
    "shell": "system",
    "working_directory": "current_project_directory",
    "dock": "bottom"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "code_actions_on_format": {
    "source.fixAll.biome": true
  },
  "file_scan_exclusions": [
    ".git",
    ".direnv",
    "result",
    "result-*",
    "node_modules",
    "target",
    "dist",
    ".next"
  ]
}
